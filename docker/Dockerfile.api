# Algo Lab Canonical Hardened Container Image
# Non-negotiable paper-only research OS container definition

FROM python:3.12-slim

LABEL org.opencontainers.image.title="Algo Lab Research OS" \
      org.opencontainers.image.version="0.3.0" \
      org.opencontainers.image.lifecycle="forward-paper-validation" \
      org.opencontainers.image.paper_only="true" \
      org.opencontainers.image.description="Hardened quantitative research and paper simulation OS for Indian markets"

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    LIVE_TRADING_ENABLED=false \
    REAL_BROKER_EXECUTION_ENABLED=false

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create non-root system group and user
RUN groupadd -g 10001 algolab && \
    useradd -u 10001 -g algolab -d /app -s /usr/sbin/nologin algolab

COPY requirements-pinned.txt pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-pinned.txt

COPY . .
RUN pip install --no-cache-dir -e . && \
    chown -R 10001:10001 /app

# Switch to non-root execution
USER 10001:10001

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/health || exit 1

CMD ["uvicorn", "apps.api.main:app", "--host", "127.0.0.1", "--port", "8000"]
