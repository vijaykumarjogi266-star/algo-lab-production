[Unit]
Description=Algo Lab Autonomous EOD Swing Trading Daemon (Zero Human Intervention)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/algolab
Environment="PYTHONPATH=/home/ubuntu/algolab"
Environment="ALLOW_LIVE_TRADING=False"
Environment="DAEMON_STRATEGY=STRATEGY_SUPER_ADAPTIVE"
ExecStart=/home/ubuntu/algolab/.venv/bin/python3 /home/ubuntu/algolab/live_market_daemon.py --loop-daily
Restart=always
RestartSec=30s
KillMode=mixed
TimeoutStopSec=30s

# Security and Isolation Limits
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
