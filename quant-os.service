[Unit]
Description=QUANT-OS Stage 6 — Autonomous Lifecycle & Calendar Manager
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu
Environment="PYTHONPATH=/home/ubuntu/algolab"
Environment="ALLOW_LIVE_TRADING=False"
ExecStart=/home/ubuntu/algolab/.venv/bin/python3 -m oms_project.trading_scheduler
Restart=on-failure
RestartSec=10s
KillMode=mixed
TimeoutStopSec=30s

# Security and Isolation Limits
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
